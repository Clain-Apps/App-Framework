{
  "name": "@app-framework/dev-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Adopts App-Framework in an application, reports integration status, and applies selected capabilities.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clain-Apps/App-Framework.git",
    "directory": "packages/dev-tools"
  },
  "bin": {
    "framework": "./dist/bin/framework.js",
    "framework-check": "./dist/bin/framework-check.js",
    "framework-setup": "./dist/bin/framework-setup.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.7.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-dev-tools-consumer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
